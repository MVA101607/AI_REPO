@echo off
chcp 65001 > nul
cls
echo ====================================================================
echo              СИНХРОНИЗАЦИЯ С РЕПОЗИТОРИЕМ ПОСЛЕ ОЧИСТКИ
echo ====================================================================
echo Этот скрипт нужно запускать на ПК других пользователей репозитория.
echo Скрипт приводит в соответствие файлы НА ДАННОМ ПК с файлами на 
echo сервере после его очистки.
echo Перед запуском скрипта скопируйте все архивные/неактивные
echo проекты во внешнее хранилище. УДАЛИТЕ папки архивных проектов
echo из этой рабочей директории.
echo ====================================================================
echo.
echo Вы готовы продолжить? 
echo [1] Да, начать очистку.
echo [2] Нет, я хочу выйти и проверить файлы.
echo.

set /p user_choice="Введите цифру 1 или 2 и нажмите Enter: "

if "%user_choice%"=="1" goto start_process
if "%user_choice%"=="2" goto cancel_process

:incorrect_choice
echo.
echo [!] Неверный ввод. Пожалуйста, введите 1 или 2.
timeout /t 3 > nul
goto :EOF

:cancel_process
echo.
echo === Отмена операции. Скрипт закрывается, ничего не изменено. ===
pause
exit

:start_process

:: 1. Скачивание обновлений
echo [1/3] Получение данных с сервера...
git fetch origin
if %errorlevel% neq 0 goto error

:: 2. Жесткий сброс локальной истории под версию GitHub
echo [2/3] Сброс локальной ветки main под серверную копию...
git reset --hard origin/main
if %errorlevel% neq 0 goto error

:: 3. Очистка локального мусора от старых проектов
echo [3/3] Запуск сборщика мусора для освобождения места на диске...
git reflog expire --expire=now --all
git gc --prune=now --aggressive
git branch -u origin/main

echo.
echo === Успешно! Ваша рабочая копия синхронизирована и очищена. ===
pause
exit

:error
echo.
echo [ОШИБКА] Синхронизация прервана. Проверьте подключение к GitHub.
pause
